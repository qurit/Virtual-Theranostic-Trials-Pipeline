{
  // ---------------------------------------------------------------------------
  // Virtual Theranostic Trials (VTT) — Pipeline Configuration Template
  // ---------------------------------------------------------------------------
  //
  // QUICK-START
  // -----------
  // 1. Copy and rename this file (e.g. inputs/my_config.json).
  // 2. Set "output_folder_title" to your study name.
  // 3. Set SIMINDDirectory in src/data/pipeline_paths.json.
  // 4. Adjust roi_subset and simulation parameters for your study.
  // 5. Run: python main.py --config_file inputs/my_config.json --input_ct_dir /path/to/cts [--spect] [--dosimetry] [--postprocess]
  // ---------------------------------------------------------------------------

  // Project folder name created under the repo root. Each patient CT gets its own subfolder: <title>/CT_<index>/
  "output_folder_title": "test_run",

  // ==========================================================================
  // PHASE 1 — Digital Twin & Ground Truth
  // ==========================================================================
  "phase_1": {

    // ── 1.1  Segmentation + ROI Unification ───────────────────────────────────
    "segmentation_stage": {

      // Organs to segment and carry into all downstream stages.
      // Valid names: see "VTT_allowed_rois" in src/data/pipeline_roi_naming_map.json.
      // Reserved labels (background, body, synthetic_lesion) must NOT appear here.
      // Every ROI used in simulation or lesion specs must be listed here.
      "roi_subset": ["kidney", "liver", "prostate", "spleen", "heart", "salivary_glands"]
    },

    // ── 1.2  Synthetic Lesion Generation  (auto-runs when specs are present) ──
    "synthetic_lesions_stage": {

      // Global RNG seed across all organs. 0 = non-reproducible.
      "default_seed": 123,

      // Radius shrink factor when a lesion cannot be placed (must be in (0,1)).
      "auto_shrink_factor": 0.85,

      // Maximum radius-reduction steps before abandoning a lesion.
      "auto_max_shrink_iters": 30,

      // Starting radius as a fraction of the organ's maximum inscribed sphere (0–1).
      "auto_start_frac": 0.60,

      // Maximum random coordinate draws per lesion before giving up.
      "max_lesion_placement_attempts": 4000,

      // Per-organ lesion specs. Set to null to skip lesion insertion.
      // Each key must appear in segmentation_stage.roi_subset and must have a
      // dedicated non-Rest PBPK VOI in pipeline_roi_naming_map.json.
      //
      // Placement modes (prob):
      //   "uniform"      — random placement anywhere inside the organ
      //   "gaussian"     — placement weighted towards the organ centroid (add "sigma_mm")
      //   "user_defined" — exact voxel centers supplied by you (requires "radii_mm" and "user_centers_zyx")
      //
      // Optional: "radii_mm" — list of N radii in mm, one per lesion.
      //           Omit for auto-radius (derived from organ volume and n_lesions).
      //
      // Common fields: n_lesions, margin_mm (mm clearance), seed (0 = non-reproducible).
      "specs": {
        "liver": {
          "n_lesions": 5,
          "prob": "gaussian",
          "sigma_mm": 60.0,
          "margin_mm": 1.0,
          "seed": 0
        }
      }
    },

    // ── 1.3  PBPK TAC Generation ───────────────────────────────────────────────
    "pbpk_tac_stage": {

      // Pharmacokinetic model. Currently only "PSMA" (Lu-177 PSMA) is supported.
      "model_type": "PSMA",

      // Radionuclide. Must match the isotope used in simulation stages.
      "isotope": "lu177",

      // Draw kidney and salivary-gland PBPK parameters from lognormal distributions
      // to model inter-patient pharmacokinetic variability. false = deterministic.
      "Randomization_Kidney_SG_Para": true
    }
  },

  // ==========================================================================
  // PHASE 2 — Simulations
  // ==========================================================================
  "phase_2": {

    // ── 2.1  SIMIND SPECT Simulation  (requires --spect) ──────────────────────
    "simind_stage": {

      // ROIs to simulate. Must be a subset of segmentation_stage.roi_subset and
      // have a dedicated non-Rest PBPK VOI in pipeline_roi_naming_map.json.
      // If any selected ROI has synthetic lesions, all lesion-host ROIs must be
      // selected; the internal synthetic_lesion/Tumor1 source is added automatically.
      "roi_subset": ["liver", "kidney", "salivary_glands"],

      // Target voxel spacing in mm as [sxy, sxy, sz], or null to use native CT spacing.
      // X and Y must match (square in-plane voxels).
      // XY must be >= both native in-plane spacings; Z must be >= native Z (only coarser grids allowed).
      // The pipeline logs the native CT spacing at runtime so you know the baseline.
      // Example: native CT is [0.977, 0.977, 3.0] mm — set [2.0, 2.0, 3.0] to halve in-plane.
      // The resulting voxel counts are derived automatically from the physical CT extent.
      "xyz_spacing_mm": null,

      // Collimator code. Must match a *.col file in your SIMIND installation.
      "Collimator": "si-me",

      // Isotope code for SIMIND physics lookup.
      "isotope": "lu177",

      // Angular projection views over a full 360° rotation.
      // Minimum: 64 — fewer causes angular undersampling and streak artifacts in OSEM.
      // Rule: phase_3.spect_postprocess_stage.Subsets × Iterations ≤ NumProjections.
      // Typical clinical range: 64–128.
      "NumProjections": 64,

      // Total photon histories. Higher = lower noise, longer runtime. (e.g. 1e8)
      "NumPhotons": 1e8,

      // Photopeak energy window width as % of photopeak energy. (Lu-177 typical: 20%)
      "EnergyWindowWidth": 20,

      // Source-to-collimator-face distance in cm. Negative = auto-contour to patient.
      "DetectorDistance": -10,

      // Detector crystal width in cm. (e.g. 53.3 = large-FOV Siemens Symbia)
      "DetectorWidth": 53.3,

      // Detector crystal axial length in cm. 0 = infer from CT axial extent.
      "DetectorLength": 0,

      // Output projection image size in pixels per side (square).
      "OutputImgSize": 128,

      // Output pixel pitch in cm. (e.g. 0.5 cm = 5 mm pixels)
      "OutputPixelWidth": 0.5,

      // Output slice thickness in cm.
      "OutputSliceWidth": 0.5,

      // CPU cores for parallel simulation. 0 = use all available.
      "num_cpu": 0
    },

    // ── 2.2  OpenGATE Dosimetry Simulation  (requires --dosimetry) ────────────
    "opengate_stage": {

      // ROIs to compute dose maps for. Must be a subset of segmentation_stage.roi_subset
      // and have a dedicated non-Rest PBPK VOI in pipeline_roi_naming_map.json.
      // Synthetic lesion source handling follows the same rule as SIMIND.
      "roi_subset": ["liver", "kidney", "salivary_glands"],

      // Save a per-ROI dose map NIfTI for each simulated organ (Gy/decay).
      "save_per_roi_dose_maps": true,

      // Save dose summed across all ROIs into a single NIfTI (Gy/decay).
      // OpenGATE always writes this final total dose map.
      "save_summed_dose_map": true,

      // Save final relative statistical uncertainty maps alongside dose maps.
      // OpenGATE adaptive stopping always computes these maps.
      "save_uncertainty_map": true,

      // Save the Schneider HU→material label image used internally.
      "save_material_label_image": true,

      // Also write outputs as MetaImage (.mhd/.raw) in addition to NIfTI.
      "write_mhd_outputs": false,

      // Target voxel spacing in mm as [sxy, sxy, sz], or null to use native CT spacing.
      // X and Y must match (square in-plane voxels).
      // XY must be >= both native in-plane spacings; Z must be >= native Z (only coarser grids allowed).
      // The pipeline logs the native CT spacing at runtime so you know the baseline.
      // Dose maps are saved on the selected simulation grid; null keeps the native CT grid.
      "xyz_spacing_mm": null,

      // Enable forced-detection variance reduction (valid for Lu-177 when voxel size << photon mean-free path).
      "variance_reduction": true,

      "gate": {
        // Particle histories per adaptive batch. Larger batches reduce OpenGATE startup overhead;
        // smaller batches stop closer to the requested uncertainty. (e.g. 1e6)
        "total_histories_per_batch": 1e6,

        // Parallel OpenGATE threads. 0 = use all available CPUs.
        "num_threads": 0,

        // Stop each ROI when the 95th percentile of ROI voxel uncertainty is under this percent.
        "target_uncertainty_percent": 5,

        // Run OpenGATE in a fresh subprocess (recommended for memory isolation).
        "start_new_process": true
      },

      "source": {
        // Isotope for radioactive decay physics. Must be supported by Gate's RadioactiveDecay module.
        "isotope": "lu177"
      },

      "physics": {
        // HU-to-material grouping tolerance in g/cm³. Smaller = more materials, slower.
        "density_tolerance_gcm3": 0.05,

        // World bounding box scale factor relative to patient extent. (1.4 = 40% margin)
        "world_margin_scale": 1.4,

        // Minimum simulation world size in mm.
        "world_min_size_mm": 400.0,

        // Secondary electron tracking cutoff in mm. Smaller = more accurate beta dose, slower.
        "electron_production_cut_mm": 0.5
      }
    }
  },

  // ==========================================================================
  // PHASE 3 — Post-Processing
  // ==========================================================================
  "phase_3": {

    // ── 3.1  SPECT Post-Processing  (requires --postprocess --spect) ──────────
    "spect_postprocess_stage": {

      // Weight projections by PBPK TAC before summing ROI contributions.
      "apply_tac": true,

      // Add Poisson counting noise for realistic scanner statistics.
      "apply_poisson_noise": true,

      // Run PyTomography OSEM+TEW reconstruction.
      "apply_reconstruction": true,

      // Frame start times in minutes post-injection. One value per frame.
      // Example: [120, 1440, 2880] = scans at 2 h, 24 h, 48 h p.i.
      "FrameStartTimes": [120, 1440, 2880],

      // Frame acquisition durations in seconds. Must match FrameStartTimes length.
      // These durations are always applied so weighted projections are true counts.
      "FrameDurations": [10, 10, 10],

      // Reconstruction algorithm. Currently only "OSEM" (with TEW scatter correction).
      "ReconstructionAlgorithm": "OSEM",

      // OSEM reconstruction iterations.
      // Constraint: Subsets × Iterations must not exceed phase_2.simind_stage.NumProjections.
      "Iterations": 4,

      // OSEM ordered subsets. Higher values accelerate convergence but may reduce stability.
      // Constraint: Subsets × Iterations must not exceed phase_2.simind_stage.NumProjections.
      "Subsets": 8
    },

    // ── 3.2  Dosimetry Post-Processing  (requires --postprocess --dosimetry) ──
    "dosemap_postprocess_stage": {

      // Scale each ROI's dose map by its TAC-derived cumulated activity → total absorbed dose in Gy.
      "apply_tac": true
    }
  }
}
